{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "super-note",
  "version": "0.0.15",
  "identifier": "com.nikhi.super-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "super-note",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "os": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MEQyMjBGNjUwNjM0QjkKUldTNU5BWmxEeUlOSjFjY1JiUTRIZ3QycjRWTmdxY1AxRXFKWlRscHVkQjNGRStFZkNoWjI3bngK",
      "dialog": true,
      "endpoints": [
        "https://github.com/solid-droid/Super-Note/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../Sidecar/src-bun/bun-sidecar",
      "../Sidecar/src-python/python-sidecar"
    ]
  }
}